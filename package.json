{
  "name": "dobara",
  "version": "0.1.0",
  "private": true,
  "description": "The retention agent for consumer brands: voice check-ins on Bolna and Plivo that bring customers back.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:reset": "node --env-file=.env.local scripts/reset-db.mjs",
    "agent:sync": "node --env-file=.env.local scripts/sync-agent.mjs",
    "bolna:me": "node --env-file=.env.local scripts/whoami.mjs"
  },
  "dependencies": {
    "@bolna/web-call": "3.0.1",
    "@electric-sql/pglite": "^0.5.11",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
