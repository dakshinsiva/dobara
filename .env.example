# ---- Bolna (https://platform.bolna.ai -> Developers -> API keys) ----
BOLNA_API_KEY=
# Printed by `pnpm agent:sync` the first time; paste it here afterwards
BOLNA_AGENT_ID=
# Optional. A Plivo number bought or linked in Bolna (needs Indian KYC). Blank = Bolna's shared Plivo +91 number.
BOLNA_FROM_NUMBER=
# Optional. Comma-separated words to bias Sarvam transcription (brand, products, flavours)
STT_KEYWORDS=Cosmix, Dobara, protein, pea protein, mocha, cacao, strawberry, scoop, WhatsApp

# ---- Database ----
# Local default is embedded Postgres (PGlite, zero setup). Production: Neon via `vercel integration add neon`.
DATABASE_URL=pglite://.data/dobara

# ---- Webhooks ----
# Public URL Bolna can reach: an ngrok URL locally, your Vercel URL in production. Re-run `pnpm agent:sync` after changing it.
PUBLIC_BASE_URL=
# Shared secret appended to the webhook URL as ?token=
WEBHOOK_SECRET=change-me
# Encrypts store tokens at rest (falls back to WEBHOOK_SECRET). Use a long random string in production.
INTEGRATION_SECRET=
# Protects /api/cron/sync (Vercel Cron sends it automatically when set in the project)
CRON_SECRET=

# ---- Brand defaults ----
DEFAULT_COUNTRY_CODE=+91
BRAND_NAME=Cosmix
OFFER_TEXT=10% off the next order with code DOBARA10, valid for 7 days
# Link sent with the WhatsApp reorder message
REORDER_URL=https://cosmix.in
# Display-only conversion for Bolna's USD costs
INR_PER_USD=84
